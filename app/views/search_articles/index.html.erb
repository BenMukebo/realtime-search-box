<div class="max-w-2xl mx-auto">
  <h1 class="text-3xl font-bold mb-6 text-center text-blue-700">Search Analytics</h1>
  
  <div class="bg-white rounded-lg shadow p-6 mb-8">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-semibold mb-4 text-gray-800">Recent Searches</h2>
      <span class="text-sm text-gray-500"> <strong>IP: </strong><%= @user.ip_address %></span>
    </div>
    <div>
      <% if @user_searches&.any? %>
        <ul class="divide-y divide-gray-200">
          <%= render partial: 'search', collection: @user_searches %>
        </ul>
      <% else %>
        <div class="py-8 text-center text-gray-500">No search history found</div>
      <% end %>
    </div>
  </div>
  <div class="text-center">
    <%= link_to root_path, class: "inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" do %>
      Back to Search
    <% end %>
  </div>
</div>
